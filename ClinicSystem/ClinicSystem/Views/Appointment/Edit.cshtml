@model ClinicSystem.ViewModels.AppointmentVM

@{
    ViewData["Title"] = "Edit Appointment";
}

<h2>Edit Appointment</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Appointment.Id"/>
    <div class="form-group">
        <label>Doctor</label>
        <select asp-for="Appointment.DoctorId" class="form-control">
            @foreach (var doctor in Model.Doctors)
            {
                <option value="@doctor.Id">@doctor.Name</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Patient</label>
        <select asp-for="Appointment.PatientId" class="form-control">
            @foreach (var patient in Model.Patients)
            {
                <option value="@patient.Id">@patient.Name</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Date</label>
        <input asp-for="Appointment.Date" class="form-control" type="datetime-local" />
    </div>

    <div class="form-group">
        <label>Status</label>
        <select asp-for="Appointment.Status" class="form-control">
            <option value="Pending">Pending</option>
            <option value="Confirmed">Confirmed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <br />

    <input type="submit" value="Edit" class="btn btn-primary" />

</form>